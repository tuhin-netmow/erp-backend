{
  "name": "hms-modular-backend",
  "version": "1.0.0",
  "description": "Hospital Management System - Modular Node.js + MySQL API (Zod + Pagination)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "node migrations/migrate.js",
    "db:migrate:cli": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "migration:generate": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.15.3",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.7",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.3"
  }
}
